# Copy to .env and set your actual numbers before the first run.
# International format digits only; no + sign or spaces.
BOT_NUMBER=
OWNER_NUMBER=
OWNER_NAME=Light V


# Optional repository and channel links used by info/menu commands.
REPOSITORY_URL=https://github.com/lightevil96-svg/Alvareth-Bot
WHATSAPP_CHANNEL_URL=
WHATSAPP_CHANNEL_ID=

# API key for Kyzz search services (needed if the endpoint requires authentication).
KYZZ_API_KEY=
# Optional persistent data overrides (defaults to ~/.alvareth-bot-data outside the repo).
ALVARETH_DATA_DIR=
WA_SESSION_DIR=

# Optional HTTP server port. Set this to the Pterodactyl allocation port to expose /health and the Video Studio API.
PORT=

# LightJurnal Video Studio remote-render API.
# Generate a unique random value with at least 32 characters; never commit the real key.
VIDEO_STUDIO_API_KEY=
VIDEO_STUDIO_ALLOWED_ORIGINS=https://lightjurnal.my.id

# Dedicated remotely-managed Cloudflare Tunnel for https://video.lightjurnal.my.id.
# Copy the tunnel token from Cloudflare Zero Trust > Networks > Tunnels > lightjurnal-video-studio > Add a replica.
# Keep the token private. The bot stores it in ALVARETH_DATA_DIR/video-studio/tunnel-token with mode 0600.
VIDEO_STUDIO_TUNNEL_TOKEN=
# Optional: use a custom path instead of the persistent default token file.
VIDEO_STUDIO_TUNNEL_TOKEN_FILE=
# Optional: set an explicit cloudflared binary path. If omitted, the bot detects or downloads the official Linux binary and verifies SHA-256.
CLOUDFLARED_BIN=
# Set false only when you intentionally want to disable the Video Studio tunnel.
VIDEO_STUDIO_TUNNEL=true

# Optional OpenAI-compatible text model for prompt-to-storyboard planning.
# Keep credentials on the Alvareth server; they are never sent to the LightJurnal browser.
# If the key is empty, the planner tries the existing API-Faa GPT-prompt endpoint as a best-effort fallback.
VIDEO_STUDIO_AI_BASE_URL=https://api.openai.com/v1
VIDEO_STUDIO_AI_API_KEY=
VIDEO_STUDIO_AI_MODEL=gpt-4.1-mini
VIDEO_STUDIO_AI_TIMEOUT_MS=90000
VIDEO_STUDIO_AI_FALLBACK_URL=https://api-faa.my.id/faa/gpt-promt

# Optional natural AI narration and word-level subtitle timing via ElevenLabs.
# Create the API key in ElevenLabs and choose a voice ID available to your account.
# These credentials stay on the Alvareth server and are never sent to LightJurnal.
VIDEO_STUDIO_ELEVENLABS_API_KEY=
VIDEO_STUDIO_ELEVENLABS_VOICE_ID=
VIDEO_STUDIO_ELEVENLABS_MODEL_ID=eleven_multilingual_v2
VIDEO_STUDIO_ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
VIDEO_STUDIO_ELEVENLABS_MAX_CHARS=4000

# Optional licensed stock-video search via Pexels. Credits are burned into the relevant scenes.
VIDEO_STUDIO_PEXELS_API_KEY=
VIDEO_STUDIO_PEXELS_MAX_SCENES=8
VIDEO_STUDIO_MEDIA_TIMEOUT_MS=90000

# Optional local open-source generation through ComfyUI (Wan 2.2 / LTX video workflows and ACE-Step audio workflows).
# Import an API-format workflow JSON from ComfyUI and replace node input values with {{PROMPT}},
# {{NEGATIVE_PROMPT}}, {{WIDTH}}, {{HEIGHT}}, {{DURATION}}, {{FPS}}, {{SEED}}, and (for image-to-video) {{REFERENCE_IMAGE}} placeholders.
# Video workflow must save MP4/WebM/MOV under ComfyUI output; music workflow must save WAV/MP3/FLAC/OGG.
# Keep the ComfyUI server private (localhost/VPN); never expose it directly to the public internet.
VIDEO_STUDIO_COMFYUI_URL=http://127.0.0.1:8188
VIDEO_STUDIO_COMFYUI_API_KEY=
# Optional: image workflow that creates one reusable character reference from the AI character bible.
VIDEO_STUDIO_COMFYUI_IMAGE_WORKFLOW_FILE=
# Video workflow should use {{REFERENCE_IMAGE}} in its LoadImage node for image-to-video continuity.
VIDEO_STUDIO_COMFYUI_VIDEO_WORKFLOW_FILE=
VIDEO_STUDIO_COMFYUI_MUSIC_WORKFLOW_FILE=
VIDEO_STUDIO_COMFYUI_MAX_VIDEO_SCENES=2
VIDEO_STUDIO_COMFYUI_TIMEOUT_MS=900000
VIDEO_STUDIO_RENDER_CONCURRENCY=
VIDEO_STUDIO_RENDER_TIMEOUT_MS=900000

# Owner-only WhatsApp prompt-to-video workflow (.remotion).
# The default limit is two active render jobs; these are server safeguards, not user controls.
VIDEO_STUDIO_WA_MAX_ACTIVE_JOBS=2
VIDEO_STUDIO_WA_POLL_INTERVAL_MS=6000
VIDEO_STUDIO_WA_WATCH_TIMEOUT_MS=1800000
VIDEO_STUDIO_WA_PROMPT_TTL_MS=600000

# WhatsApp media delivery (.clip and .download share one disk-streaming uploader).
# Defaults: ./downloads, 2 GiB - 10 MiB max file size, all detected videos sent as video messages,
# 30-minute Baileys media upload timeout, and up to 3 queued jobs per socket.
ALVARETH_DOWNLOAD_DIR=./downloads
ALVARETH_DOWNLOAD_MAX_BYTES=
ALVARETH_WA_UPLOAD_TIMEOUT_MS=1800000
ALVARETH_WA_MAX_PENDING_UPLOADS=3
# Writable server-disk temp folder for Baileys media encryption; default: ~/.alvareth-bot-data/tmp.
ALVARETH_WA_TMPDIR=

# GitHub automatic self-update.
# Checks on startup (when a Git checkout is available) and periodically in the bot worker.
# Reuses the protected owner updater; no .update command or PM2 installation is required.
# Changed dependencies are installed automatically and the supervised worker restarts safely.
# Set false to disable automatic updates; .update remains available as a manual command.
AUTO_UPDATE_ENABLED=true
AUTO_UPDATE_BRANCH=main
AUTO_UPDATE_INTERVAL_MINUTES=10
# Optional token increases GitHub API rate limits; keep it private and never commit it.
ALVARETH_GITHUB_TOKEN=

NODE_ENV=production
