# Copy to .env and set your actual numbers before the first run.
# International format digits only; no + sign or spaces.
BOT_NUMBER=
# WhatsApp login: pairing (default) or qr. Pairing code appears in the server console.
WA_LOGIN_METHOD=pairing
OWNER_NUMBER=
OWNER_NAME=Light V

# Optional repository and channel links used by info/menu commands.
REPOSITORY_URL=https://github.com/lightevil96-svg/Alvareth-Bot
WHATSAPP_CHANNEL_URL=
WHATSAPP_CHANNEL_ID=

# API key for Kyzz search services (needed if the endpoint requires authentication).
KYZZ_API_KEY=
# Optional persistent data overrides (defaults to ~/.alvareth-bot-data outside the repo).
ALVARETH_DATA_DIR=
WA_SESSION_DIR=

PORT=

# WhatsApp media delivery (.clip and .download share one disk-streaming uploader).
# Defaults: ./downloads, 2 GiB - 10 MiB max file size, all detected videos sent as video messages,
# 30-minute Baileys media upload timeout, and up to 3 queued jobs per socket.
ALVARETH_DOWNLOAD_DIR=./downloads
ALVARETH_DOWNLOAD_MAX_BYTES=
ALVARETH_WA_UPLOAD_TIMEOUT_MS=1800000
ALVARETH_WA_MAX_PENDING_UPLOADS=3
# Writable server-disk temp folder for Baileys media encryption; default: ~/.alvareth-bot-data/tmp.
ALVARETH_WA_TMPDIR=

# GitHub automatic self-update.
# Checks on startup (when a Git checkout is available) and periodically in the bot worker.
# Reuses the protected owner updater; no .update command or PM2 installation is required.
# Changed dependencies are installed automatically and the supervised worker restarts safely.
# Set false to disable automatic updates; .update remains available as a manual command.
AUTO_UPDATE_ENABLED=true
AUTO_UPDATE_BRANCH=main
AUTO_UPDATE_INTERVAL_MINUTES=10
# Optional token increases GitHub API rate limits; keep it private and never commit it.
ALVARETH_GITHUB_TOKEN=


# Owner-only .analisis audiovisual video intelligence. Keep the Gemini key private.
GEMINI_API_KEY=
ALVARETH_VIDEO_ANALYSIS_MODEL=gemini-3.8-flash
# static is the default for full-video analysis; agentic is experimental.
ALVARETH_VIDEO_ANALYSIS_PROCESSING=static
ALVARETH_VIDEO_ANALYSIS_MAX_BYTES=262144000
ALVARETH_VIDEO_ANALYSIS_MAX_DURATION_SECONDS=1800
ALVARETH_VIDEO_ANALYSIS_TIMEOUT_MS=1200000
ALVARETH_VIDEO_ANALYSIS_RETENTION_HOURS=24

# Optional Cutroom sidecar for real-face active-speaker detection and face tracking.
# Bind the Cutroom service to localhost. Its upstream API has no authentication by default.
ALVARETH_CUTROOM_API_URL=
ALVARETH_CUTROOM_API_TOKEN=
ALVARETH_CUTROOM_ALLOW_REMOTE=false
ALVARETH_CUTROOM_REQUIRED=false
ALVARETH_CUTROOM_TIMEOUT_MS=2700000

# Optional WhisperX + pyannote sidecar for word alignment and audio speaker diarization.
# Leave URL empty to use Gemini's multimodal transcript fallback.
ALVARETH_WHISPERX_API_URL=
ALVARETH_WHISPERX_ENDPOINT=/diarize
ALVARETH_WHISPERX_API_TOKEN=
ALVARETH_WHISPERX_LANGUAGE=auto
ALVARETH_WHISPERX_REQUIRED=false
ALVARETH_WHISPERX_MIN_SPEAKERS=
ALVARETH_WHISPERX_MAX_SPEAKERS=

NODE_ENV=production

# Owner-only .remotion project ZIP rendering (defaults to ~/.alvareth-bot-data/remotion-jobs).
ALVARETH_REMOTION_TMPDIR=
# Optional absolute Chrome/Chromium executable. Leave empty to use Remotion-managed Chrome Headless Shell.
ALVARETH_REMOTION_BROWSER_EXECUTABLE=
